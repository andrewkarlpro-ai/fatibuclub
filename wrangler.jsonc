{
  // Cloudflare Workers config for FatiBuClub (Next.js 16 via @opennextjs/cloudflare)
  "name": "fatibuclub",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_RUNTIME": "edge",
    // Non-secret config: the inbox that receives contact-form submissions.
    "DESTINATION_EMAIL": "fatibuclub@gmail.com",
    // Sender used by Resend. Must be on a verified domain in your Resend account.
    // Falls back to onboarding@resend.dev if your domain isn't verified yet.
    "FROM_EMAIL": "FatiBuClub <onboarding@resend.dev>"
  },
  // D1 database for persistent submission storage.
  // database_id is filled in after `wrangler d1 create fatibuclub`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fatibuclub",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ]
}
