{
  // Cloudflare Workers config for FatiBuClub (Next.js 16 via @opennextjs/cloudflare)
  "name": "fatibuclub",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_RUNTIME": "edge",
    // Non-secret config: the inbox that receives contact-form submissions.
    "DESTINATION_EMAIL": "fatibuclub@gmail.com",
    // Sender used by Resend. Must be on a verified domain in your Resend account.
    // onboarding@resend.dev works out of the box for testing until you verify a domain.
    "FROM_EMAIL": "FatiBuClub <onboarding@resend.dev>"
  }
  // D1 database binding — re-enable after the Cloudflare API token is granted
  // the "D1:Edit" scope and the database is created (`wrangler d1 create fatibuclub`).
  // The /api/contact route already gracefully skips persistence when DB is absent.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "fatibuclub",
  //     "database_id": "PASTE_REAL_ID_HERE"
  //   }
  // ]
}
