{
  // Cloudflare Workers config for FatiBuClub (Next.js 16 via @opennextjs/cloudflare)
  "name": "fatibuclub",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_RUNTIME": "edge",
    // Non-secret config: the inbox that receives contact-form submissions.
    "DESTINATION_EMAIL": "fatibuclub@gmail.com",
    // Sender used by Resend. Must be on a verified domain in your Resend account.
    // onboarding@resend.dev works out of the box for testing until you verify a domain.
    "FROM_EMAIL": "FatiBuClub <onboarding@resend.dev>"
  },
  // Workers KV namespace for persistent submission storage.
  // Created via: wrangler kv namespace create SUBMISSIONS
  // (token already has Workers KV Storage: Edit scope — no permission change needed)
  "kv_namespaces": [
    {
      "binding": "SUBMISSIONS",
      "id": "e85bd16011634a83b83527423968c897"
    }
  ]
}
